# ===========================================
# Digital Geoff - Zero Cost Configuration
# ===========================================
#
# This configuration uses ONLY FREE services.
# Estimated monthly cost: $0
#
# Copy to .env and fill in your values.

# ===========================================
# LLM PROVIDERS (Tiered - Cheapest First)
# ===========================================

# GROQ (FREE - 14,400 requests/day)
# Sign up at: https://console.groq.com
# This is your PRIMARY LLM - fast and free
GROQ_API_KEY=gsk_...

# OLLAMA (FREE - Local, unlimited)
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull models: ollama pull mistral:latest && ollama pull qwen2.5:3b
# Runs automatically if installed
OLLAMA_HOST=http://localhost:11434

# ANTHROPIC (PAID - Fallback only)
# Leave empty to disable paid fallback
# Only used for complex tasks that free models fail
ANTHROPIC_API_KEY=

# ===========================================
# TELEGRAM BOT (FREE - Replaces Twilio SMS)
# ===========================================
#
# 1. Message @BotFather on Telegram
# 2. Send /newbot and follow prompts
# 3. Copy the token here
#
# To get your user ID:
# 1. Message @userinfobot on Telegram
# 2. It will tell you your user ID

TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_ALLOWED_USERS=123456789  # Comma-separated user IDs
TELEGRAM_PRIMARY_CHAT_ID=123456789  # Your chat ID for notifications

# ===========================================
# STORAGE (All Local/Free)
# ===========================================

# SQLite - Memory and state
SQLITE_PATH=/data/sqlite/digital_geoff.db

# ChromaDB - Vector embeddings
CHROMA_PATH=/data/chroma

# JSON - Knowledge graph
KNOWLEDGE_PATH=/data/knowledge

# ===========================================
# OPTIONAL: Microsoft 365 (Free with subscription)
# ===========================================
# If you already have Microsoft 365, this is free to use.
# Azure AD app registration takes ~15 minutes.

MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_USER_EMAIL=

# ===========================================
# OPTIONAL: Asana (Free tier available)
# ===========================================
# Free for up to 10 users
# Get token: https://app.asana.com/0/my-apps

ASANA_TOKEN=
ASANA_WORKSPACE_ID=

# ===========================================
# OPTIONAL: Slack (Free for small teams)
# ===========================================
# Create app at: https://api.slack.com/apps

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=

# ===========================================
# OPTIONAL: GitHub (Free)
# ===========================================
# Get token: https://github.com/settings/tokens

GITHUB_TOKEN=

# ===========================================
# OPTIONAL: Notion (Free tier available)
# ===========================================
# Create integration: https://www.notion.so/my-integrations

NOTION_API_KEY=

# ===========================================
# OPTIONAL: Google Workspace (Free tier)
# ===========================================
# Sheets/Slides API has generous free tier

GOOGLE_CREDENTIALS_PATH=

# ===========================================
# OPTIONAL: Discord (FREE)
# ===========================================
# Alternative to Slack - completely free
# Create bot: https://discord.com/developers/applications

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
