# Digital Geoff - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# ANTHROPIC (Required)
# ===========================================
ANTHROPIC_API_KEY=sk-ant-api03-...

# ===========================================
# MICROSOFT 365 (Outlook, Teams, OneDrive)
# ===========================================
# Create an Azure AD app registration:
# 1. Go to Azure Portal > Azure Active Directory > App registrations
# 2. Create new registration
# 3. Add API permissions: Mail.Read, Mail.Send, Calendars.ReadWrite, User.Read
# 4. Create client secret

MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_USER_EMAIL=your.email@company.com

# ===========================================
# ASANA
# ===========================================
# Get token from: https://app.asana.com/0/my-apps
# Create a Personal Access Token

ASANA_TOKEN=
ASANA_WORKSPACE_ID=

# ===========================================
# SLACK
# ===========================================
# Create a Slack app at: https://api.slack.com/apps
# Enable: Bot Token Scopes (chat:write, channels:read, im:read, im:write, users:read)
# Enable: Event Subscriptions (message.channels, message.im, app_mention)

SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=general

# ===========================================
# TWILIO (SMS)
# ===========================================
# Sign up at: https://www.twilio.com
# Get a phone number capable of SMS

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1987654321  # Your phone number

# ===========================================
# GOOGLE WORKSPACE
# ===========================================
# Create a service account in Google Cloud Console
# Enable: Sheets API, Slides API, Drive API
# Download credentials JSON

GOOGLE_CREDENTIALS_PATH=/path/to/google-credentials.json

# ===========================================
# NOTION
# ===========================================
# Create an integration at: https://www.notion.so/my-integrations
# Share pages/databases with the integration

NOTION_API_KEY=secret_...

# ===========================================
# GITHUB
# ===========================================
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, read:org

GITHUB_TOKEN=ghp_...

# ===========================================
# INFRASTRUCTURE (Production)
# ===========================================
# Redis for memory and checkpoints
REDIS_URL=redis://localhost:6379

# Neo4j for knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=digitalgeoff

# Vector store (Qdrant)
QDRANT_URL=http://localhost:6333

# ===========================================
# OPTIONAL: MEM0 (Enhanced Memory)
# ===========================================
# MEM0_API_KEY=

# ===========================================
# OPTIONAL: COGNEE (Knowledge Graph)
# ===========================================
# COGNEE_API_KEY=
