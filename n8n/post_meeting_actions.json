{
  "name": "Digital Geoff - Post-Meeting Action Capture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-notes",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Receive Meeting Notes",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "meeting-notes"
    },
    {
      "parameters": {
        "url": "={{$env.DIGITAL_GEOFF_URL}}/api/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"Extract action items from these meeting notes and create Asana tasks. Notes: {{$json.body.notes}}. Meeting: {{$json.body.meeting_name}}. Attendees: {{$json.body.attendees}}. For each action item: identify owner, set due date based on urgency, tag with relevant project. Return JSON with created_tasks array.\"\n}",
        "options": {}
      },
      "id": "extract-actions",
      "name": "Extract Actions via Digital Geoff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "Digital Geoff API"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "post",
        "channel": "={{$env.SLACK_DM_CHANNEL}}",
        "text": "✅ *Meeting Actions Captured*\n\nFrom: {{$json.meeting_name}}\nTasks created: {{$json.created_tasks.length}}\n\n{{$json.created_tasks.map(t => '• ' + t.name + ' → ' + t.assignee).join('\\n')}}"
      },
      "id": "confirm",
      "name": "Send Confirmation",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [650, 300],
      "credentials": {
        "slackOAuth2Api": {
          "id": "2",
          "name": "Slack Account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\": \"processed\", \"tasks_created\": {{$json.created_tasks.length}}}"
      },
      "id": "response",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Receive Meeting Notes": {
      "main": [
        [
          {
            "node": "Extract Actions via Digital Geoff",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Actions via Digital Geoff": {
      "main": [
        [
          {
            "node": "Send Confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Confirmation": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
