{
  "name": "Digital Geoff - Meeting Prep Generator",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{$env.DIGITAL_GEOFF_URL}}/api/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"query\": \"Check if there's a meeting starting in the next 2 hours that needs prep. If so, generate meeting prep including: attendee context, talking points, questions to ask, and any relevant background from our knowledge base. Return JSON with: needs_prep (boolean), meeting_name, prep_content.\"\n}",
        "options": {}
      },
      "id": "check-meetings",
      "name": "Check Upcoming Meetings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "Digital Geoff API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.needs_prep}}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-needs-prep",
      "name": "Needs Prep?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "post",
        "channel": "={{$env.SLACK_DM_CHANNEL}}",
        "text": "📋 *Meeting Prep: {{$json.meeting_name}}*\n\n{{$json.prep_content}}"
      },
      "id": "send-prep",
      "name": "Send Prep via Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [850, 200],
      "credentials": {
        "slackOAuth2Api": {
          "id": "2",
          "name": "Slack Account"
        }
      }
    },
    {
      "parameters": {},
      "id": "no-op",
      "name": "No Prep Needed",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Check Upcoming Meetings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Upcoming Meetings": {
      "main": [
        [
          {
            "node": "Needs Prep?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Prep?": {
      "main": [
        [
          {
            "node": "Send Prep via Slack",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Prep Needed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
